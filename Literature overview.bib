@article{darowickiPolynomialAnalysisNew2023,
  title = {Polynomial Analysis as a New Way of Describing Dynamic Impedance Spectra -- {{Differential}} and Relative Impedance Spectra},
  author = {Darowicki, Kazimierz and Wysmu{\l}ek, Szymon and Kar{\'o}lkowska, Anna},
  year = 2023,
  month = may,
  journal = {Electrochemistry Communications},
  volume = {150},
  pages = {107476},
  issn = {1388-2481},
  doi = {10.1016/j.elecom.2023.107476},
  urldate = {2025-06-13},
  abstract = {Model measurements of an equivalent electrical system were carried out using the technique of Dynamic Electrochemical Impedance Spectroscopy. The measurement took the form of potentiodynamic changes imposed on the tested system. Using the possibility of continuous impedance measurements, an attempt was made to develop an original and innovative method of analyzing impedance spectrograms, which is termed polynomial analysis. As a result of this approach, it is possible to generate two novel impedance spectra from the primary impedance spectrogram. The innovation lies in the use of simple polynomials to describe a set of spectra, and then performing differential and division operations, which result in differential- and relative-impedance spectra. Among other things, differential spectra have the ability to track the rate of change in impedance as a function of an independent variable. By contrast, relative impedance spectra eliminate surface influence, which opens the way to the direct comparison of physicochemical processes and more.},
  keywords = {Differential analysis,Dynamic electrochemical impedance spectroscopy,Polynomial analysis,Relative impedance},
  file = {C\:\\Users\\fscarp\\Zotero\\storage\\D543TX9L\\Darowicki et al. - 2023 - Polynomial analysis as a new way of describing dyn.pdf;C\:\\Users\\fscarp\\Zotero\\storage\\4Z27IIV4\\S1388248123000504.html}
}

