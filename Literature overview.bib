@article{meeusenFEMModellingPredict2023,
  title = {{{FEM}} Modelling to Predict Spatiotemporally Resolved Water Uptake in Organic Coatings: {{Experimental}} Validation by Odd Random Phase Electrochemical Impedance Spectroscopy Measurements},
  shorttitle = {{{FEM}} Modelling to Predict Spatiotemporally Resolved Water Uptake in Organic Coatings},
  author = {Meeusen, M. and {van Dam}, J. P. B. and Madelat, N. and Jalilian, E. and Wouters, B. and Hauffman, T. and Van Assche, G. and Mol, J. M. C. and Hubin, A. and Terryn, H.},
