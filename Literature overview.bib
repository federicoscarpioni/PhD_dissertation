  file = {C\:\\Users\\fscarp\\Zotero\\storage\\KRQLZM39\\Pettit and Roy - 2005 - Role of iodate ions in chemical mechanical and electrochemical mechanical planarization of Ta invest.pdf;C\:\\Users\\fscarp\\Zotero\\storage\\26KLWN5H\\S0167577X05007019.html}
}

@article{pettitTimeResolvedStudy2004,
