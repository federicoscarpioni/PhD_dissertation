@article{hallemansOperandoElectrochemicalImpedance2022,
  title = {Operando Electrochemical Impedance Spectroscopy and Its Application to Commercial {{Li-ion}} Batteries},
  author = {Hallemans, No{\"e}l and Widanage, Widanalage Dhammika and Zhu, Xinhua and Moharana, Sanghamitra and Rashid, Muhammad and Hubin, Annick and Lataire, John},
  year = 2022,
