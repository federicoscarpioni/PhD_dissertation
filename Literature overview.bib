@article{nagySituElectrochemicalImpedance2002,
  title = {In Situ Electrochemical Impedance Spectroscopy of {{Zr}}--1\%{{Nb}} under {{VVER}} Primary Circuit Conditions},
  author = {Nagy, Gabor and Kerner, Zsolt and Pajkossy, Tam{\'a}s},
  year = {2002},
