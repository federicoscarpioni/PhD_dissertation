@article{oldhamFractionalDifferentialEquations2010,
  title = {Fractional Differential Equations in Electrochemistry},
  author = {Oldham, Keith B.},
  date = {2010-01},
  journaltitle = {Advances in Engineering Software},
  shortjournal = {Advances in Engineering Software},
  volume = {41},
  number = {1},
