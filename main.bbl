      \field{journaltitle}{Journal of Electroanalytical Chemistry and Interfacial Electrochemistry}
      \field{month}{12}
      \field{number}{2}
      \field{title}{On-Line {{FFT}} Faradaic Admittance Measurements Application to {{A}}.{{C}}. Cyclic Voltammetry}
